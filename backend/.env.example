# Local development only. Copy to .env and adjust if needed.
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://sara:sara_local_dev@127.0.0.1:5432/sara

# JSON-Logs nach stderr; Standard: the_sara_protocol=info.
# Auch bei debug erscheinen nur gezielt ausgewaehlte Anwendungsfelder.
RUST_LOG=the_sara_protocol=info
