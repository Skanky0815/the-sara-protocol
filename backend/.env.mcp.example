# Nur synthetischer lokaler Pilot; nach .env.mcp kopieren (gitignored).
# Eigene Datenbank verwenden, keine echten Gespräche importieren.
DATABASE_URL=postgres://sara:sara_local_dev@127.0.0.1:5432/sara_mcp_pilot
# Pflicht: ID einer ausdrücklich ausgewählten synthetischen Persona.
# Nach dem Anlegen setzen; 0 wird absichtlich abgelehnt.
MCP_PERSONA_ID=0
MIGRATIONS_DIR=./migrations
RUST_LOG=the_sara_protocol=info
